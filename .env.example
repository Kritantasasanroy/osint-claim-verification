NVIDIA_API_KEY=nvapi-...
TAVILY_API_KEY=tvly-...

# Optional overrides (defaults shown)
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# OCR_MODEL=nvidia/nemotron-parse
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# LLM_REASONING=true
# MAX_CONCURRENT_REQUESTS=4
# PRICE_INPUT_PER_MTOK=0.10
# PRICE_OUTPUT_PER_MTOK=0.50
# CACHE_PATH=.cache/responses.sqlite3

# Judge on another model family than the agent (E5)
# JUDGE_MODEL=z-ai/glm-5.3-flash
# LLM_TEMPERATURE=0.2

# Primary-record tools (G1). Wikidata, GLEIF, SEC EDGAR, CourtListener and Wayback need no key;
# SEC asks for a contact in the User-Agent. Sanctions screening is only offered with an OpenSanctions key.
# SEC_USER_AGENT=YourOrg research you@example.com
# COURTLISTENER_TOKEN=
# OPENSANCTIONS_API_KEY=
